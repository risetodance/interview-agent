# ==================== 服务器配置 ====================
# SSH 连接信息
SERVER_HOST=your_server_ip
SERVER_USER=root

# ==================== Spring Profile 配置 ====================
# 激活的 Spring Profile (dev/prod)
SPRING_PROFILES_ACTIVE=prod

# ==================== 后端配置 ====================
# 后端 Docker 镜像名称和标签
BACKEND_IMAGE_NAME=interview-agent
BACKEND_IMAGE_TAG=latest

# 后端部署目录（服务器上存放 jar 和 Dockerfile 的目录）
BACKEND_DEPLOY_DIR=/opt/interview-agent/app

# ==================== 前端配置 ====================
# 前端部署路径（服务器上的静态资源目录）
FRONTEND_DIST_DIR=/var/www/interview-agent

# 前端调用的后端 API 地址（部署后前端访问的地址）
API_BASE_URL=http://your_server_ip:7777

# ==================== 小程序配置 ====================
# 小程序部署路径
MINIPROGRAM_DIST_DIR=/var/www/interview-agent/miniprogram

# ==================== 数据库配置（服务器已有） ====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_password_here

# ==================== 对象存储配置 ====================
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin
APP_STORAGE_BUCKET=interview-agent
APP_STORAGE_REGION=us-east-1

# ==================== AI 配置 ====================
MINIMAX_API_KEY=your_api_key_here
MINIMAX_API_HOST=https://api.minimaxi.com

# Embedding 模型配置（可选，不填则使用公共配置）
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# ==================== 应用配置 ====================
# JWT 密钥（生产环境必须修改）
JWT_SECRET=interview-agent-jwt-secret-key-must-be-at-least-512-bits-long-for-hs512

# CORS 允许的源（前端地址）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# 面试追问数量
APP_INTERVIEW_FOLLOW_UP_COUNT=1

# MCP 搜索配置
APP_MCP_WEBSEARCH_ENABLED=true

# ==================== 微信小程序配置 ====================
WECHAT_MINIAPP_APPID=your_appid
WECHAT_MINIAPP_SECRET=your_secret

# ==================== 监控配置 ====================
PROMETHEUS_DATA_DIR=/opt/interview-agent/prometheus/data
# Prometheus 配置目录（docker-compose.yml 挂载 prometheus.yml 的宿主机目录，deploy.sh 自动上传配置）
PROMETHEUS_CONFIG_DIR=/opt/interview-agent/prometheus/config
GRAFANA_DATA_DIR=/opt/interview-agent/grafana/data

# ==================== 存储路径配置 ====================
REDIS_DATA_DIR=/opt/interview-agent/redis/data
REDIS_LOGS_DIR=/opt/interview-agent/redis/logs
POSTGRES_DATA_DIR=/opt/interview-agent/postgres/data
POSTGRES_LOGS_DIR=/opt/interview-agent/postgres/logs
RUSTFS_DATA_DIR=/opt/interview-agent/rustfs/data
RUSTFS_LOGS_DIR=/opt/interview-agent/rustfs/logs
BACKEND_LOG_DIR=/opt/interview-agent/agent/logs

# ==================== 腾讯云 SES 邮件配置（邮箱验证码，API 调用，个人用户 SMTP 已停用） ====================
# SES 控制台（https://console.cloud.tencent.com/ses）创建发信地址；
# secretId/secretKey 建议用子账号访问密钥并只授予 SES 权限（https://console.cloud.tencent.com/cam）
SES_SECRET_ID=your_secret_id
SES_SECRET_KEY=your_secret_key
SES_REGION=ap-guangzhou
SES_FROM_EMAIL=noreply@yourdomain.com
# 发件人展示名（用于发件人别名，模板方式下邮件主题由模板配置决定）
SES_MAIL_FROM_NAME=AI 面试指南
# 发信模板 ID（控制台 https://console.cloud.tencent.com/ses → 发信模板，创建并审核通过后填入；
# 个人用户仅支持模板发送，Simple 直接正文方式已废弃）
# 验证码模板正文示例：您正在进行{{scene}}操作，验证码为 {{code}}，{{minutes}} 分钟内有效。如非本人操作，请忽略本邮件。
SES_TEMPLATE_CODE_ID=0
# 换绑通知模板正文示例：您的账号绑定邮箱已变更为 {{newEmail}}。如非本人操作，请立即登录修改密码。
SES_TEMPLATE_NOTIFY_ID=0
